{
  "name": "junctura-core-foundation",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "check": "node scripts/check.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:neutral": "node scripts/check-domain-neutral.mjs",
    "check:contracts": "python -B scripts/check-contracts.py",
    "check:reuse": "node scripts/check-reuse.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:contract-validator": "python -B scripts/check-contracts.py --self-test",
    "test": "node --test \"tests/*.test.mjs\"",
    "healthcheck": "node --env-file-if-exists=.env scripts/check-health.mjs --ready",
    "doctor": "node scripts/doctor.mjs",
    "app:enroll": "node --env-file=.env scripts/enroll-app.mjs",
    "audit:demo": "node --env-file=.env scripts/audit-demo.mjs",
    "trust:demo": "node --env-file=.env scripts/trust-demo.mjs",
    "demo:provision": "node --env-file-if-exists=.env scripts/provision-demo-admins.mjs",
    "env:provision": "node --env-file-if-exists=.env scripts/provision-demo-admins.mjs",
    "directory:provision": "node --env-file-if-exists=.env scripts/provision-directory.mjs",
    "demo:seed": "node --env-file=.env scripts/demo-seed.mjs",
    "local:demo": "node scripts/local-demo.mjs",
    "login-theme:apply": "node --env-file-if-exists=.env scripts/apply-login-theme.mjs",
    "demo:console": "docker compose --profile console build console && docker compose --profile console up -d --no-build console",
    "provider:pki": "node scripts/provider-pki.mjs",
    "backup": "node scripts/backup.mjs backup",
    "restore": "node scripts/backup.mjs restore",
    "local:up": "docker compose --profile console up --build --detach --wait --wait-timeout 900",
    "local:down": "docker compose --profile console down",
    "local:status": "docker compose --profile console ps",
    "example:foundation": "node --env-file-if-exists=.env examples/foundation-http.mjs",
    "test:setup": "node --test tests/setup.test.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:sdk": "node --test tests/sdk.test.mjs",
    "example:sdk": "node --env-file-if-exists=.env examples/sdk-foundation.mjs",
    "test:integration": "node --env-file=.env --test integration/core.mjs",
    "test:admin-mfa": "node --env-file=.env --test integration/admin-mfa.mjs",
    "test:malware-scan": "node --env-file=.env --test integration/malware-scan.mjs",
    "test:secrets": "node --env-file=.env --test integration/secrets.mjs",
    "test:recovery": "node --env-file=.env --test integration/recovery.mjs",
    "test:records": "node --env-file=.env --test integration/records.mjs",
    "test:record-queries": "node --env-file=.env --test integration/record-queries.mjs",
    "test:record-archives": "node --env-file=.env --test integration/record-archives.mjs",
    "test:field-masking": "node --env-file=.env --test integration/field-masking.mjs",
    "test:app-group-shares": "node --env-file=.env --test integration/app-group-shares.mjs",
    "test:directory": "node --env-file=.env --test integration/directory.mjs",
    "test:workflow-tasks": "node --env-file=.env --test integration/workflow-tasks.mjs",
    "test:workflow-task-output": "node --env-file=.env --test integration/workflow-task-output.mjs",
    "test:applications": "node --env-file=.env --test integration/applications.mjs",
    "test:capabilities": "node --env-file=.env --test integration/capabilities.mjs",
    "test:compositions": "node --env-file=.env --test integration/compositions.mjs",
    "test:audit": "node --env-file=.env --test integration/audit.mjs",
    "test:audit-app": "node --env-file=.env --test integration/audit-app.mjs",
    "test:events": "node --env-file=.env --test integration/events.mjs",
    "test:object-metadata": "node --env-file=.env --test integration/object-metadata.mjs",
    "test:search": "node --env-file=.env --test integration/search.mjs",
    "test:subject-access": "node --env-file=.env --test integration/subject-access.mjs",
    "test:flowable-worker": "node --test integration/flowable-worker.mjs",
    "test:provider-network": "node --test integration/provider-network.mjs",
    "test:execution-ledger": "node --test integration/execution-ledger.mjs",
    "test:migrations": "node --test integration/migration-integrity.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "test:console-container": "node scripts/check-console-container.mjs",
    "console": "npm --prefix console run dev",
    "console:build": "npm --prefix console run build",
    "console:test": "npm --prefix console test",
    "console:check:endpoints": "npm --prefix console run check:endpoints",
    "test:app-access": "node --env-file-if-exists=.env --test integration/app-access.mjs",
    "test:delegation": "node --env-file-if-exists=.env --test integration/delegation.mjs",
    "test:consent": "node --env-file-if-exists=.env --test integration/consent.mjs",
    "test:consent-requests": "node --env-file-if-exists=.env --test integration/consent-requests.mjs",
    "test:access-requests": "node --env-file-if-exists=.env --test integration/access-requests.mjs",
    "test:catalog-visibility": "node --env-file-if-exists=.env --test integration/catalog-visibility.mjs"
  }
}
