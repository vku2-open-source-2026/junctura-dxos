<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://junctura.invalid/core/workflows">
  <process id="junctura_xac_minh_don_thuoc" name="Xác minh đơn thuốc" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="to_nha_thuoc" sourceRef="start" targetRef="nha_thuoc_gui" />
    <userTask id="nha_thuoc_gui" name="Nhà thuốc gửi" flowable:candidateGroups="nha-thuoc" />
    <sequenceFlow id="to_benh_vien" sourceRef="nha_thuoc_gui" targetRef="benh_vien_xac_nhan" />
    <userTask id="benh_vien_xac_nhan" name="Bệnh viện xác nhận" flowable:candidateGroups="benh-vien" />
    <sequenceFlow id="to_hoan_tat" sourceRef="benh_vien_xac_nhan" targetRef="hoan_tat" />
    <userTask id="hoan_tat" name="Hoàn tất" flowable:candidateGroups="benh-vien" />
    <sequenceFlow id="to_end" sourceRef="hoan_tat" targetRef="end" />
    <endEvent id="end" />
  </process>
</definitions>
